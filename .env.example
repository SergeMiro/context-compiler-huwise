# Copy to .env. Defaults match docker-compose.yml (local stand only).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=ctxc
DB_USER=ctxc
DB_PASSWORD=ctxc-local
DB_ROOT_PASSWORD=ctxc-local-root
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:5673//
ES_URL=http://127.0.0.1:9200
NEO4J_URL=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ctxc-local-pass
# Share of a portal's daily Explore API quota the scanner may use
CTXC_SCAN_BUDGET_PCT=5
# LLM (OpenAI-compatible endpoint). Model is chosen later; empty = LLM features disabled.
CTXC_LLM_BASE_URL=
CTXC_LLM_API_KEY=
CTXC_LLM_MODEL=
CTXC_LLM_TIMEOUT=60
CTXC_LLM_NAME=openrouter
# optional backup provider with its own limits (switch on the page; fallback on 429): NVIDIA NIM
CTXC_LLM2_NAME=nim
CTXC_LLM2_BASE_URL=https://integrate.api.nvidia.com/v1
CTXC_LLM2_API_KEY=
CTXC_LLM2_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# local admin (manage.py createsuperuser --noinput --username admin --email admin@localhost)
DJANGO_SUPERUSER_PASSWORD=
